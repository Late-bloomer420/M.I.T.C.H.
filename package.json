{
  "name": "antigravity-edge",
  "version": "1.0.0",
  "description": "Local security layer for multi-agent systems",
  "main": "src/index.ts",
  "scripts": {
    "test": "npm run test:setup",
    "test:setup": "node ./node_modules/tsx/dist/cli.mjs ./src/test/setup.ts",
    "test:audit": "node ./node_modules/tsx/dist/cli.mjs ./src/test/audit_setup.ts",
    "test:hitl": "node ./node_modules/tsx/dist/cli.mjs ./src/test/hitl_setup.ts",
    "test:intent": "node ./node_modules/tsx/dist/cli.mjs ./src/test/intent_setup.ts",
    "test:rag": "node ./node_modules/tsx/dist/cli.mjs ./src/test/rag_setup.ts",
    "test:rbac": "node ./node_modules/tsx/dist/cli.mjs ./src/test/rbac_setup.ts",
    "test:sandbox": "node ./node_modules/tsx/dist/cli.mjs ./src/test/sandbox_setup.ts",
    "test:stream": "node ./node_modules/tsx/dist/cli.mjs ./src/test/stream_setup.ts",
    "test:token": "node ./node_modules/tsx/dist/cli.mjs ./src/test/token_setup.ts",
    "test:tpm": "node ./node_modules/tsx/dist/cli.mjs ./src/test/tpm_setup.ts",
    "test:electron": "node ./node_modules/tsx/dist/cli.mjs ./src/test/electron_setup.ts",
    "test:chat": "node ./node_modules/tsx/dist/cli.mjs ./src/test/chat_simulation.ts",
    "test:final": "node ./node_modules/tsx/dist/cli.mjs ./src/test/final_loop.ts",
    "test:setup-suite": "npm run test:setup && npm run test:audit && npm run test:hitl && npm run test:intent && npm run test:rag && npm run test:rbac && npm run test:sandbox && npm run test:stream && npm run test:token && npm run test:tpm",
    "test:demo": "npm run test:electron && npm run test:chat && npm run test:final",
    "test:all": "npm run test:setup-suite && npm run test:demo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.12",
    "drizzle-kit": "^0.20.18",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
